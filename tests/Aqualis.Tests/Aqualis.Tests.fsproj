<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Aqualis.fsproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestHelpers.fs" />
    <Compile Include="UnsupportedOperationTests.fs" />
    <Compile Include="CodeWriterTests.fs" />
    <Compile Include="CompilerScriptTests.fs" />
    <Compile Include="FileResourceTests.fs" />
    <Compile Include="GenerationContextTests.fs" />
    <Compile Include="OpenMpGenerationTests.fs" />
    <Compile Include="PythonFunctionGenerationTests.fs" />
    <Compile Include="PythonImportTests.fs" />
    <Compile Include="StructureDependencyTests.fs" />
    <Compile Include="AssignmentTests.fs" />
    <Compile Include="ExpressionSimplificationTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <Compile Include="NumericFormattingTests.fs" />
    <Compile Include="ControlFlowGenerationTests.fs" />
    <Compile Include="NumericArrayGenericTests.fs" />
    <Compile Include="GeometryCrtpTests.fs" />
    <Compile Include="InterpolationTests.fs" />
    <Compile Include="OptimizationTests.fs" />
    <Compile Include="IterativeSolverTests.fs" />
    <Compile Include="Graph1dTests.fs" />
    <Compile Include="LapackRankGenerationTests.fs" />
    <Compile Include="LapackSvdGenerationTests.fs" />
    <Compile Include="LapackAliasGenerationTests.fs" />
    <Compile Include="LapackSolveGenerationTests.fs" />
    <Compile Include="LapackBackendGenerationTests.fs" />
    <Compile Include="LapackDeterminantGenerationTests.fs" />
    <Compile Include="PhpUploadGenerationTests.fs" />
    <Compile Include="PhpCommunicationGenerationTests.fs" />
    <Compile Include="PhpArrayGenerationTests.fs" />
    <Compile Include="ChTests.fs" />
    <Compile Include="GoldenFileTests.fs" />
    <Compile Include="MarkdownTests.fs" />
    <Compile Include="Plot2dTests.fs" />
    <Compile Include="WebGenerationStateTests.fs" />
    <Compile Include="SecurityGenerationTests.fs" />
    <Compile Include="TypedWebApiTests.fs" />
    <Compile Include="PhpResponseGenerationTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
